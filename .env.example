# Application
APP_ENV=development

# Database
DATABASE_URL=sqlite:///./data/resale_manager.db

# Reporting
BASE_CURRENCY=USD
ANALYTICS_SLOW_MOVING_DAYS=30

# Exchange rates (manual-only by default; online FX is optional)
FX_PROVIDER=MANUAL
FX_AUTO_UPDATE=false
FX_FRESHNESS_HOURS=24

# Optional elTOQUE provider configuration
ELTOQUE_API_TOKEN=
ELTOQUE_API_URL=https://api.eltoque.com/v1/rates
ELTOQUE_TIMEOUT_SECONDS=10
