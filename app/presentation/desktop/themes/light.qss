QWidget {
    color: #111827;
}

QMainWindow {
    background: #f5f6f8;
}

#sidebar {
    background: #1f2937;
    border: none;
}

#brand {
    color: #f9fafb;
    font-size: 18px;
    font-weight: 600;
    padding: 22px 20px 6px 20px;
}

#brandSubtitle {
    color: #9ca3af;
    font-size: 12px;
    padding: 0 20px 18px 20px;
}

#navigation {
    background: transparent;
    border: none;
    color: #d1d5db;
    font-size: 14px;
}

#navigation::item {
    padding: 10px 18px;
    margin: 2px 8px;
    border-radius: 6px;
}

#navigation::item:hover {
    background: #374151;
}

#navigation::item:selected {
    background: #2563eb;
    color: #ffffff;
}

#content {
    background: #f5f6f8;
}

#settingsScrollArea,
#settingsContent {
    background: #f5f6f8;
    border: none;
}

#pageTitle {
    color: #111827;
    font-size: 26px;
    font-weight: 600;
}

#pageDescription {
    color: #4b5563;
    font-size: 14px;
}

#pageSeparator {
    background: #e5e7eb;
    border: none;
    margin: 8px 0;
}

#pageBadge {
    background: #e0e7ff;
    color: #3730a3;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
}

#pageNote {
    color: #6b7280;
    font-size: 13px;
}

#settingsDataStatus,
#settingsPreferencesStatus {
    color: #4b5563;
    font-size: 12px;
}

QStatusBar {
    background: #ffffff;
    color: #4b5563;
    border-top: 1px solid #e5e7eb;
}

QMenuBar {
    background: #ffffff;
    color: #374151;
}

QMenuBar::item:selected {
    background: #f3f4f6;
}

QMenu {
    background: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
}

QMenu::item:selected {
    background: #dbeafe;
    color: #111827;
}

QPushButton {
    background: #ffffff;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
}

QPushButton:hover {
    background: #f3f4f6;
}

QPushButton:pressed {
    background: #e5e7eb;
}

QPushButton:focus {
    border-color: #2563eb;
}

QPushButton:disabled {
    background: #f9fafb;
    color: #9ca3af;
    border-color: #e5e7eb;
}

QPushButton[variant="primary"] {
    background: #2563eb;
    color: #ffffff;
    border-color: #2563eb;
    font-weight: 600;
}

QPushButton[variant="primary"]:hover {
    background: #1d4ed8;
}

QPushButton[variant="primary"]:disabled {
    background: #bfdbfe;
    color: #eff6ff;
    border-color: #bfdbfe;
}

QLineEdit,
QComboBox,
QPlainTextEdit {
    background: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 13px;
}

QLineEdit:focus,
QComboBox:focus,
QPlainTextEdit:focus {
    border-color: #2563eb;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    selection-background-color: #dbeafe;
    selection-color: #111827;
}

QCheckBox {
    color: #374151;
    font-size: 13px;
    spacing: 6px;
}

QTableView {
    background: #ffffff;
    color: #111827;
    alternate-background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    gridline-color: #f3f4f6;
    selection-background-color: #dbeafe;
    selection-color: #111827;
}

QTableView::item {
    padding: 7px 8px;
    border: none;
}

QHeaderView::section {
    background: #f9fafb;
    color: #6b7280;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    padding: 8px;
    font-size: 12px;
    font-weight: 600;
}

QTreeWidget {
    background: #ffffff;
    color: #111827;
    alternate-background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 4px;
}

QTreeWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
}

QTreeWidget::item:selected {
    background: #dbeafe;
    color: #111827;
}

#productsFooter {
    color: #6b7280;
    font-size: 12px;
}

#emptyStateTitle {
    color: #374151;
    font-size: 17px;
    font-weight: 600;
}

#emptyStateHint {
    color: #6b7280;
    font-size: 13px;
}

#errorBanner {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 13px;
}

#warningBanner {
    background: #fffbeb;
    color: #92400e;
    border: 1px solid #fde68a;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 13px;
}

#sectionTitle {
    color: #374151;
    font-size: 14px;
    font-weight: 600;
}

#metricCard,
#analyticsMetric {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

#metricTitle {
    color: #6b7280;
    font-size: 12px;
    font-weight: 600;
}

#metricValue {
    color: #111827;
    font-size: 19px;
    font-weight: 600;
}

#metricValue[negative="true"] {
    color: #b91c1c;
}

#metricHint {
    color: #6b7280;
    font-size: 11px;
}

QDialog {
    background: #f5f6f8;
}

#dialogTitle {
    color: #111827;
    font-size: 20px;
    font-weight: 600;
}

#dialogSummary {
    color: #4b5563;
    font-size: 13px;
}

#fieldHint {
    color: #6b7280;
    font-size: 12px;
}

QDateEdit,
QDateTimeEdit,
QSpinBox {
    background: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 5px 7px;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: #e5e7eb;
    color: #4b5563;
    border: 1px solid #e5e7eb;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 14px;
    margin-right: 2px;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #111827;
    font-weight: 600;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-top: 10px;
    padding: 12px 10px 8px 10px;
    font-size: 13px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #374151;
}

QToolTip {
    background: #111827;
    color: #f9fafb;
    border: 1px solid #374151;
    padding: 4px 6px;
}

/* UI-4/5/6: shell, dashboard sections and reusable status styling */
#sidebar {
    background: #111827;
    border-right: 1px solid #1f2937;
}

#sidebarBrandRow,
#sidebarFooter {
    background: transparent;
}

#brandMark {
    background: #2563eb;
    color: #ffffff;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 700;
}

#brand {
    padding: 0;
    font-size: 15px;
}

#brandSubtitle {
    padding: 0;
    font-size: 11px;
}

#sidebarSectionLabel {
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    padding: 8px 20px 4px 20px;
}

#navigation:focus {
    border: 1px solid #3b82f6;
    border-radius: 8px;
}

#navigation::item {
    padding: 9px 14px;
    margin: 1px 10px;
    border-radius: 7px;
}

#navigation::item:selected {
    background: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

#sidebarDivider {
    background: #334155;
    border: none;
}

#sidebarCurrencyLabel {
    color: #94a3b8;
    font-size: 11px;
}

#statusBadge {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

#pageStack,
#dashboardScrollArea,
#dashboardViewport,
#dashboardContent {
    background: #f5f6f8;
    border: none;
}

#pageEyebrow {
    color: #2563eb;
    font-size: 10px;
    font-weight: 700;
}

#filterBar {
    background: transparent;
}

#filterLabel {
    color: #6b7280;
    font-size: 12px;
    font-weight: 600;
}

#sectionCard {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

#sectionTitle {
    color: #111827;
    font-size: 14px;
    font-weight: 600;
}

#sectionDescription {
    color: #6b7280;
    font-size: 11px;
}

#metricCard {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

#metricCard[tone="accent"] {
    border-top: 3px solid #2563eb;
}

#metricCard[tone="positive"] {
    border-top: 3px solid #059669;
}

#metricCard[tone="negative"] {
    border-top: 3px solid #dc2626;
}

#metricCard[tone="warning"] {
    border-top: 3px solid #d97706;
}

#metricCard[tone="neutral"] {
    border-top: 3px solid #cbd5e1;
}

#metricValue {
    font-size: 22px;
}

#emptyState {
    background: transparent;
    border: 1px dashed #d1d5db;
    border-radius: 8px;
}

#emptyStateIcon {
    color: #9ca3af;
    font-size: 20px;
}

#emptyStateTitle {
    color: #374151;
    font-size: 14px;
    font-weight: 600;
}

#emptyStateHint {
    color: #6b7280;
    font-size: 11px;
}

#chartWidget {
    background: transparent;
}

#dashboardFooter {
    color: #6b7280;
    font-size: 11px;
}

#baseCurrencyLabel {
    color: #4b5563;
    font-size: 11px;
}

QTableView:focus {
    border: 1px solid #2563eb;
}

QStatusBar::item {
    border: none;
}
QHeaderView {
    background: #f9fafb;
}

QTableCornerButton::section {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
}
#dashboardProductsTabs::pane {
    border: none;
    background: transparent;
    top: 0;
}

#dashboardProductsTabs QTabBar::tab {
    padding: 5px 12px;
    font-size: 11px;
}
#sidebarSectionLabel {
    color: #94a3b8;
}
#dashboardProductsTabs QTabBar {
    background: transparent;
}
